{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "separateMajorMinor": true,
  "rangeStrategy": "bump",
  "gitAuthor": "hermesmge <hermesmge@gmail.com>",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GitHub dependencies in PlatformIO lib_deps",
      "fileMatch": ["(^|/)platformio\\.ini$"],
      "matchStrings": [
        "https:\\/\\/github\\.com\\/(?<depName>[^#\\s]+?)(?:\\.git)?#(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "Group all PlatformIO firmware dependencies",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["helty-nodemcu-firmware/platformio.ini"],
      "groupName": "platformio-firmware-deps",
      "commitMessageTopic": "{{depName}}"
    },
    {
      "description": "Disable auto-merge for all updates",
      "matchPackagePatterns": ["*"],
      "automerge": false
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.git/**"
  ]
}
